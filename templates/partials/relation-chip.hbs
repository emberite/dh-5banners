<span class="dh5b-relation tone-{{tone}} {{#if unknown}}unknown{{/if}}" data-faction-id="{{id}}" data-action="dh5bOpenFaction"
    data-tooltip-text="{{signed}} {{label}}{{#if note}} · {{note}}{{/if}}{{#if unknown}} ({{localize 'DH5B.Relations.UnknownHint'}}){{/if}}">
    <img src="{{img}}" alt="" style="--dh5b-chip-color: {{color}}" />
    <span class="dh5b-relation-name">{{name}}</span>
    <span class="dh5b-relation-value">{{signed}}</span>
</span>
